{
  "name": "ppstudio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "clean": "rm -rf .next",
    "predev": "prisma generate",
    "dev": "next dev",
    "dev:clean": "npm run clean && npm run dev",
    "dev:webpack": "next dev --webpack",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "RUN_DB_INTEGRATION_TESTS=1 node --import ./src/test/register-server-only.mjs --import tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "rm -rf coverage .nyc_output && c8 node --import ./src/test/register-server-only.mjs --import tsx --test \"src/**/*.test.ts\"",
    "pretest:e2e": "PLAYWRIGHT_PORT=${PLAYWRIGHT_PORT:-3100}; NEXT_PUBLIC_APP_URL=${PLAYWRIGHT_BASE_URL:-http://127.0.0.1:$PLAYWRIGHT_PORT} NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL:-https://ppstudio.cz} NEXT_PUBLIC_MATOMO_ENABLED=true NEXT_PUBLIC_MATOMO_URL=https://matomo.example.test/ NEXT_PUBLIC_MATOMO_SITE_ID=1 NEXT_PUBLIC_META_PIXEL_ENABLED=true NEXT_PUBLIC_META_PIXEL_ID=123456789 npm run build",
    "test:e2e": "playwright test",
    "test:db:booking": "RUN_DB_INTEGRATION_TESTS=1 node --import ./src/test/register-server-only.mjs --import tsx --test src/features/booking/lib/*.integration.test.ts",
    "email:worker": "tsx scripts/email-delivery-worker.ts",
    "email:worker:once": "tsx scripts/email-delivery-worker.ts --once",
    "email:previews": "NODE_ENV=test tsx scripts/generate-email-previews.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:check-migrations": "node scripts/check-migration-history.mjs",
    "analytics:check": "node scripts/check-matomo-reporting.mjs",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:import-services": "node scripts/import-services.mjs",
    "db:backfill-service-copy": "tsx scripts/backfill-service-copy.ts",
    "admin:recover-owner": "tsx scripts/recover-admin-owner.ts",
    "db:clear-booking-data": "node scripts/clear-booking-data.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.2.10",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "clsx": "^2.1.1",
    "image-size": "^2.0.2",
    "jose": "^6.2.2",
    "next": "^16.2.10",
    "nodemailer": "^9.0.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "svix": "^1.94.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "c8": "^11.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "prisma@7.8.0": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true,
    "@prisma/engines@7.8.0": true
  }
}
