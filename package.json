{
  "name": "ppstudio",
  "version": "3.13.3",
  "private": true,
  "engines": {
    "node": "^24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "clean": "rm -rf .next",
    "predev": "prisma generate",
    "dev": "next dev",
    "dev:clean": "npm run clean && npm run dev",
    "dev:fast": "next dev",
    "dev:clean:fast": "npm run clean && next dev",
    "dev:webpack": "next dev --webpack",
    "dev:turbopack": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "RUN_DB_INTEGRATION_TESTS=1 node --import ./src/test/register-server-only.mjs --import tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "rm -rf coverage .nyc_output && c8 node --import ./src/test/register-server-only.mjs --import tsx --test \"src/**/*.test.ts\"",
    "pretest:e2e": "PLAYWRIGHT_PORT=${PLAYWRIGHT_PORT:-3100}; NEXT_PUBLIC_APP_URL=${PLAYWRIGHT_BASE_URL:-http://127.0.0.1:$PLAYWRIGHT_PORT} NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL:-https://ppstudio.cz} NEXT_PUBLIC_MATOMO_ENABLED=true NEXT_PUBLIC_MATOMO_URL=https://matomo.example.test/ NEXT_PUBLIC_MATOMO_SITE_ID=1 NEXT_PUBLIC_META_PIXEL_ENABLED=true NEXT_PUBLIC_META_PIXEL_ID=123456789 npm run build",
    "test:e2e": "playwright test",
    "test:db:booking": "RUN_DB_INTEGRATION_TESTS=1 node --import ./src/test/register-server-only.mjs --import tsx --test --test-concurrency=1 src/features/booking/lib/*.integration.test.ts",
    "email:worker": "tsx scripts/email-delivery-worker.ts",
    "email:worker:once": "tsx scripts/email-delivery-worker.ts --once",
    "email:worker:check-imports": "tsx scripts/check-email-worker-imports.ts",
    "email:previews": "NODE_ENV=test tsx scripts/generate-email-previews.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:check-migrations": "node scripts/check-migration-history.mjs",
    "analytics:check": "node scripts/check-matomo-reporting.mjs",
    "changelog:check": "node scripts/check-changelog.mjs",
    "test:changelog": "node --test scripts/check-changelog.test.mjs",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:import-services": "node scripts/import-services.mjs",
    "db:backfill-service-copy": "tsx scripts/backfill-service-copy.ts",
    "admin:recover-owner": "tsx scripts/recover-admin-owner.ts",
    "db:clear-booking-data": "node scripts/clear-booking-data.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fullcalendar/react": "^7.0.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "image-size": "^2.0.2",
    "jose": "^6.2.5",
    "next": "^16.2.12",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.7",
    "recharts": "^3.10.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "svix": "^1.96.1",
    "tailwind-merge": "^3.6.0",
    "temporal-polyfill": "^1.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "c8": "^12.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "prisma": "7.9.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "prisma@7.9.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/engines@7.9.1": true
  },
  "overrides": {
    "eslint-config-next": {
      "eslint-plugin-import": {
        "minimatch": "10.2.5"
      },
      "eslint-plugin-jsx-a11y": {
        "minimatch": "10.2.5"
      },
      "eslint-plugin-react": {
        "minimatch": "10.2.5"
      }
    },
    "postcss": "8.5.23",
    "find-my-way": "9.7.0",
    "sharp": "$sharp"
  }
}
