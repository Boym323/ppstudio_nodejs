#!/usr/bin/env bash
set -euo pipefail

printf '%s\n' "$@" > "${RELEASE_TEST_SUDO_ARGS_FILE:?}"

if [[ "${1:-}" != /bin/bash || "${2:-}" != -c ]]; then
  echo "Mock sudo nespustil bezpečný environment wrapper." >&2
  exit 75
fi
wrapper_script="${3//\/usr\/bin\/systemd-run/systemd-run}"
exec /bin/bash -c "${wrapper_script}" "${4}" "${@:5}"
