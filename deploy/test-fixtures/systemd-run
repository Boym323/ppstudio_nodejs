#!/usr/bin/env bash
set -euo pipefail

printf '%s\n' "$@" > "${MOCK_SYSTEMD_RUN_ARGS_FILE:?}"

if [[ "${MOCK_SYSTEMD_RUN_FAIL:-0}" == "1" ]]; then
  exit 73
fi

working_directory=""
command_args=()
read_command=0

for argument in "$@"; do
  if [[ "${read_command}" -eq 1 ]]; then
    command_args+=("${argument}")
  elif [[ "${argument}" == "--" ]]; then
    read_command=1
  elif [[ "${argument}" == --working-directory=* ]]; then
    working_directory="${argument#--working-directory=}"
  fi
done

if [[ -z "${working_directory}" || "${#command_args[@]}" -eq 0 ]]; then
  exit 74
fi

cd "${working_directory}"
# Tento mock ověřuje sestavení launcheru, nevytváří skutečnou cgroup.
# Kernelové ověření patří skutečnému scope; zde rozbalíme jeho argumenty.
if [[ "${command_args[0]}" == /bin/bash && "${command_args[1]:-}" == */release-scope.sh ]]; then
  [[ "${#command_args[@]}" -ge 10 ]] || exit 74
  command_args=("${command_args[@]:9}")
fi
"${command_args[@]}"
